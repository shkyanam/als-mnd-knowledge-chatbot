# Create a .env file from this template and add your own key. Never commit it.
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
NEBIUS_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional LangSmith tracing. Set LANGSMITH_TRACING=true after adding your key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=als-mnd-knowledge-chatbot
